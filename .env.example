# Super Cabs Frontend Environment Variables Template
# Use the HTTPS API origin in production, for example https://api.your-domain.tld/api
REACT_APP_API_BASE_URL=http://localhost:5000/api
REACT_APP_SITE_NAME=Super Cabs
REACT_APP_PHONE_DISPLAY=+91 98424 23332
REACT_APP_WHATSAPP_NUMBER=919842423332

# Google Maps Platform (Client-Side Places API Autocomplete)
# Enable 'Places API' (New) or 'Places API' in Google Cloud Console
# For production: Restrict this key to HTTP referrers (e.g. https://yourdomain.com/*)
REACT_APP_GOOGLE_MAPS_API_KEY=
